# Copy to .env. Generate unique URL-safe secrets before any public deployment.
# Example: openssl rand -hex 32
PUBLIC_DOMAIN=game.example.com
POSTGRES_PASSWORD=replace_with_a_random_hex_value
REDIS_PASSWORD=replace_with_a_different_random_hex_value
JWT_SECRET=replace_with_at_least_64_random_hex_characters
TOTP_ENCRYPTION_KEY=replace_with_another_64_random_hex_characters
REFRESH_TOKEN_DAYS=30

# Public deployment origins; Docker Compose derives these from PUBLIC_DOMAIN.
# For local Vite development, the defaults in server/src/config.ts allow http://localhost:5173.
PUBLIC_URL=https://game.example.com
FRONTEND_ORIGINS=https://game.example.com

# Optional integrations. Accounts can still use guest mode without SMTP or Google OAuth.
SMTP_URL=
EMAIL_FROM=Dargaze <no-reply@game.example.com>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://game.example.com/api/auth/google/callback
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Enable only behind a trusted reverse proxy such as the included Caddy service.
TRUST_PROXY=true
